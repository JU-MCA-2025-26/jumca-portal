{
  "name": "jumca-portal",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx turbo dev",
    "build": "npx turbo build",
    "lint": "npx oxlint",
    "lint:fix": "npx oxlint --fix",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check",
    "client:dev": "npm --workspace @jumca/client run dev",
    "server:dev": "npm --workspace @jumca/server run dev",
    "client:build": "npm --workspace @jumca/client run build",
    "server:build": "npm --workspace @jumca/server run build",
    "server:prisma:generate": "npm --workspace @jumca/server run db:generate",
    "server:prisma:migrate": "npm --workspace @jumca/server run db:migrate",
    "server:prisma:studio": "npm --workspace @jumca/server run db:studio",
    "server:prisma:seed": "npm --workspace @jumca/server run db:seed"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "prisma": true,
    "bcrypt": true,
    "esbuild": true
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "oxlint": "^0.15.11",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "csrf-csrf": "^4.0.3",
    "react-router-dom": "^7.18.2"
  }
}
