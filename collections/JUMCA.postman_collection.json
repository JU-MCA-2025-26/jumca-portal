    {
      "name": "CRSF token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login succeeded', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const res = pm.response.json();",
              "const token = res.csrfToken;",
              "",
              "const cookieJar = pm.cookies.jar();",
              "const cookie = pm.cookies.add({",
              "    url: pm.request.url.toString(),",
              "    key: 'csrf-token',",
              "    value: token,",
              "    expires: new Date(Date.now() + 3600000 * 24 * 7) // 1 hour from now",
              "});",
              "",
              "pm.globals.set(\"csrf_token\", res.csrfToken);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/csrf-token",
          "host": [
            "{{baseUrl}}"
          ],
